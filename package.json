{
  "name": "@simplyforms/monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo for the official SimplyForms JavaScript/TypeScript client (@simplyforms/sdk).",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @simplyforms/sdk dev",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:exports": "pnpm -r check:exports",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1"
  }
}
