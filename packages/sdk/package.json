{
  "name": "@simplyforms/sdk",
  "version": "0.1.1",
  "description": "Official client for SimplyForms. Submit form data from the browser, Node 20+, Bun, Deno, or any Edge runtime.",
  "keywords": [
    "simplyforms",
    "forms",
    "form-backend",
    "form-submission",
    "form-api",
    "isomorphic",
    "edge"
  ],
  "license": "Apache-2.0",
  "author": "Simplyxity",
  "homepage": "https://www.simplyforms.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Simplyform/simplyforms-js.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Simplyform/simplyforms-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/simplyforms.global.js",
  "jsdelivr": "./dist/browser/simplyforms.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "check:exports": "publint --strict && attw --pack .",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.24",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
