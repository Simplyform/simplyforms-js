{
  "name": "@simplyforms/sdk",
  "version": "0.1.0",
  "description": "Scoped alias of the `simplyforms` package — the official SimplyForms client. Install either; the API is identical.",
  "keywords": [
    "simplyforms",
    "forms",
    "form-submission",
    "form-api",
    "sdk"
  ],
  "license": "Apache-2.0",
  "author": "Simplyxity",
  "homepage": "https://www.simplyforms.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplyform/simplyforms-js.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/simplyform/simplyforms-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests (re-export alias)\" && exit 0",
    "check:exports": "publint --strict && attw --pack .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "simplyforms": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.1",
    "publint": "^0.3.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
